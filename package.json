{
  "name": "tripadvisor-celebrity-scraper",
  "version": "1.0.0",
  "description": "Scraper to analyze celebrity mentions in TripAdvisor hotel reviews",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node scraping-browser.js && node extract-reviews.js",
    "reviews": "node extract-reviews.js",
    "export": "node export-to-csv.js",
    "chatgpt": "node chatgpt-search.js",
    "rightmove": "node rightmove-scraper.js",
    "beaches": "node beach-scraper.js",
    "beach-reviews": "node beach-reviews-extractor.js",
    "beach-export": "node beach-export-to-csv.js",
    "beaches-all": "node beach-scraper.js && node beach-reviews-extractor.js && node beach-export-to-csv.js"
  },
  "keywords": [
    "tripadvisor",
    "scraper",
    "puppeteer",
    "reviews"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.56.1",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^22.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
